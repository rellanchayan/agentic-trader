# Copy this file to .env (which is gitignored and NEVER committed) and fill in
# the keys for THIS bot's OWN separate Alpaca paper account.
#
#   cp .env.example .env
#
# This account must be DIFFERENT from the paper-trader account. Keep them isolated.

# Alpaca PAPER credentials — get from https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_KEY=PK_paper_key_here
ALPACA_SECRET_KEY=secret_here

# DO NOT change to a live endpoint. alpaca_client.py and constitution.py both
# refuse to run against anything that is not the paper host.
ALPACA_ENDPOINT=https://paper-api.alpaca.markets

# Live trading authorization — must remain false. This project is paper-only.
# Even if set to true, the code keeps refusing anything but paper.
LIVE_TRADING_AUTHORIZED=false

# Optional: account ID for your own reference (only logged, never used to trade).
ALPACA_ACCOUNT_ID=

# Optional: risk-free rate used by the Sharpe calculation (decimal). Default 0.045.
RISK_FREE_RATE=0.045
